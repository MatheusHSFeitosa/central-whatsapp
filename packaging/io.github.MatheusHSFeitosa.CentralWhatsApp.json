{
  "app-id": "io.github.MatheusHSFeitosa.CentralWhatsApp",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "base": "io.qt.PySide.BaseApp",
  "base-version": "6.11",
  "command": "central-whatsapp",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--socket=pulseaudio",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "modules": [
    {
      "name": "central-whatsapp",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/share/central-whatsapp/ui-icons",
        "install -m644 ui-icons/* /app/share/central-whatsapp/ui-icons/",
        "install -Dm644 ui_widgets.py /app/share/central-whatsapp/ui_widgets.py",
        "pip3 install --no-index --no-deps --prefix=/app dbus_next-0.2.3-py3-none-any.whl",
        "install -Dm644 desktop_notifications.py /app/share/central-whatsapp/desktop_notifications.py",
        "install -Dm644 grouping.py /app/share/central-whatsapp/grouping.py",
        "mkdir -p /app/share/central-whatsapp/service-icons",
        "install -m644 service-icons/* /app/share/central-whatsapp/service-icons/",
        "install -Dm644 central.py /app/share/central-whatsapp/central.py",
        "install -Dm644 profile_store.py /app/share/central-whatsapp/profile_store.py",
        "install -Dm644 settings_store.py /app/share/central-whatsapp/settings_store.py",
        "install -Dm644 desktop_ui.py /app/share/central-whatsapp/desktop_ui.py",
        "install -Dm644 avatar_manager.py /app/share/central-whatsapp/avatar_manager.py",
        "install -Dm644 services.py /app/share/central-whatsapp/services.py",
        "install -Dm644 check-symbolic.svg /app/share/central-whatsapp/check-symbolic.svg",
        "install -Dm644 VERSION /app/share/central-whatsapp/VERSION",
        "install -Dm644 whatsapp-web.svg /app/share/central-whatsapp/whatsapp-web.svg",
        "install -Dm644 whatsapp-web.svg /app/share/icons/hicolor/scalable/apps/io.github.MatheusHSFeitosa.CentralWhatsApp.svg",
        "install -Dm644 packaging/central-whatsapp.desktop /app/share/applications/io.github.MatheusHSFeitosa.CentralWhatsApp.desktop",
        "sed -i 's/Icon=central-whatsapp/Icon=io.github.MatheusHSFeitosa.CentralWhatsApp/' /app/share/applications/io.github.MatheusHSFeitosa.CentralWhatsApp.desktop",
        "install -Dm755 packaging/flatpak-launcher /app/bin/central-whatsapp"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".git",
            "build",
            "dist",
            ".venv",
            "__pycache__"
          ]
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/d2/fc/c0a3f4c4eaa5a22fbef91713474666e13d0ea2a69c84532579490a9f2cc8/dbus_next-0.2.3-py3-none-any.whl",
          "sha256": "58948f9aff9db08316734c0be2a120f6dc502124d9642f55e90ac82ffb16a18b"
        }
      ]
    }
  ]
}
